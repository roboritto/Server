SERVER_API_TOKEN=change_me_to_a_strong_password
TMDB_API_KEY=your_tmdb_api_key_here

# Path to your movie CSV (defaults to movie_database.csv in the project root)
CSV_FILE=movie_database.csv

# Optional: prioritize a specific host first when downloading full collections
PREFERRED_DOWNLOAD_HOST=

# Optional: timezone offset (hours from UTC) and NEW badge duration (days)
TIMEZONE_OFFSET_HOURS=8
NEW_BADGE_DAYS=7